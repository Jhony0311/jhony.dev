---
import Layout from '../../layouts/Layout.astro';
import { GardenPage } from '../../components/garden/GardenPage';
import SiteHeader from '../../components/layout/SiteHeader.astro';
import SiteContent from '../../components/layout/SiteContent.astro';

const search = Astro.url.searchParams;
const stageParam = search.get('stage');
const initialSelectedStage =
    stageParam === 'Seedling' ||
    stageParam === 'Budding' ||
    stageParam === 'Evergreen'
        ? stageParam
        : 'All';
const initialSelectedTags = (search.get('tags') ?? '')
    .split(',')
    .map((tag) => tag.trim())
    .filter(Boolean);
const initialPage = Math.max(1, Number(search.get('page') ?? 1) || 1);
---

<Layout
    title="Garden · Jonathan Ortega"
    description="A living digital garden of essays, notes, and snippets with maturity stages and evolving ideas."
>
    <SiteHeader
        eyebrow="Digital Garden"
        titleLeading="A living map of"
        titleMuted="ongoing work"
    >
        <p
            class="m-0 max-w-copy font-sans text-base font-light leading-relaxed text-ink-muted"
        >
            This is the center of gravity for my notes, essays, and snippets.
            Every entry reflects work in motion, with visible maturity stages
            and last edited dates so ideas stay useful as they evolve.
        </p>
    </SiteHeader>

    <SiteContent>
        <GardenPage
            client:load
            initialSelectedStage={initialSelectedStage}
            initialSelectedTags={initialSelectedTags}
            initialPage={initialPage}
        />
    </SiteContent>
</Layout>
